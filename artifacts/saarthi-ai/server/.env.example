# Copy to server/.env for local development. On Render, set these as
# environment variables instead. Never commit real values, and never put the
# key in an EXPO_PUBLIC_ variable (that would ship it inside the app).
OPENAI_API_KEY=
# Optional. Default: gpt-6.1-terra. Cheaper alternative: gpt-6-luna.
OPENAI_MODEL=gpt-6.1-terra
