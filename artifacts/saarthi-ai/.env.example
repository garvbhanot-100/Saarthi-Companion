# Clerk (Dashboard instance: perfect-fly-5718.clerk.accounts.dev)
# Copy to .env in this folder. From the project root after `npx -y clerk@latest auth login`:
#   cd artifacts/saarthi-ai && npx -y clerk@latest link --app app_3LcZ0a7c8bFZrLdSHgRfaytC23d && npx -y clerk@latest env pull
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Google OAuth via Clerk (optional — email/password local auth works without this):
# 1. Clerk Dashboard → Configure → SSO connections → enable Google
# 2. Clerk Dashboard → Configure → Native applications → add app package
#    com.garv.saarthiai and allowlist redirect:
#      saarthi-ai://sso-callback
# 3. Restart Expo after changing .env

# Optional: backend URL for production builds (see README.md)
# EXPO_PUBLIC_API_URL=

# Optional: Google sign-in on Android (local preview auth)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
