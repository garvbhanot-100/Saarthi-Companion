PORT=5000
# Base URL of the deployed Saarthi AI service (omit /api/assistant).
SAARTHI_AI_URL=
# Comma-separated list of admin login emails
SAARTHI_ADMIN_EMAIL=aaniya1985@gmail.com,garvbhanot990@gmail.com
SAARTHI_ADMIN_PASSWORD=change-me-to-a-long-secret
# Clerk (Google admin sign-in on web + app) — secret from Clerk Dashboard
# CLERK_SECRET_KEY=sk_test_...
# (optional legacy alias for password)
# SAARTHI_ADMIN_KEY=change-me-to-a-long-secret

# Razorpay — TEST MODE ONLY (Dashboard → Test Mode → Account & Settings → API Keys).
# Key ID must start with rzp_test_; live keys are refused by the server.
# Put real values only in artifacts/api-server/.env (git-ignored), never in the app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Test Mode → Webhooks → secret you chose for
# POST <public-url>/api/payments/razorpay/webhook
# (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# Supabase → Project Settings → Database
# Transaction pooler (API runtime)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (Prisma db push)
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
